SECRET_KEY=local-development-only-not-secret
ALLOWED_HOSTS=127.0.0.1,localhost,django-web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8001,http://localhost:8002
DATABASE_NAME=finsport
DATABASE_USER=finsport
DATABASE_PASSWORD=finsport-local-only
DATABASE_HOST=db
DATABASE_PORT=5432
EMAIL_HOST=localhost
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
INSTANCE_DOMAIN=http://localhost:8000
