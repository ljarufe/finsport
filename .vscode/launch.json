{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "finsport.settings"
      }
    },
    {
      "name": "Django: Debug server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "0.0.0.0:8002",
        "--noreload"
      ],
      "django": true,
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "finsport.settings"
      }
    }
  ]
}
